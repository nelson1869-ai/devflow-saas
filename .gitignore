# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local SQLite learning database
/data/*.db
/data/*.db-journal
/data/*.db-shm
/data/*.db-wal

# DevFlow root SQLite developer database
/devflow.db
/devflow.db-journal
/devflow.db-shm
/devflow.db-wal

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Separate learning curriculum
/src/app/learn/**

# Uploaded attachments (ignored from git)
/public/uploads/*
!/public/uploads/.gitkeep